# Telegram bot token from @BotFather
TG_BOT_TOKEN=

# Comma-separated Telegram IDs of administrators
ADMIN_TG_IDS=

# Secret key used to encrypt character passwords in the database (any long random string)
SECRET_KEY=

# SQL connection URI (default: SQLite file in server/data/)
DATABASE_URL=sqlite:data/lbast.db

# Game address
GAME_URL=http://lbast.ru

# Run browsers headless (set to false to watch them)
HEADLESS=true

# Browser user agent (standard Chrome; override if needed)
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36
